{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "album_photos",
  "description": "V1.1: 相册照片（继承相册可见性）",
  "type": "object",
  "properties": {
    "_id": { "type": "string" },
    "albumId": { "type": "string" },
    "userId": { "type": "string", "maxLength": 128 },
    "fileId": { "type": "string" },
    "thumbUrl": { "type": "string" },
    "lazySizes": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "shotAt": { "type": "string" },
    "fileSize": { "type": "number", "description": "原文件字节数（F3b 配额统计用）" },
    "backupStatus": { "type": "string", "enum": ["PENDING", "DONE", "FAIL"] },
    "backupAttempts": { "type": "number", "description": "备份重试次数（上限 3）" },
    "backupFileId": { "type": "string", "description": "异地备份产物 fileId（真实环境由 backup 云函数写入）" },
    "backupAt": { "type": "string", "format": "date-time" },
    "backupError": { "type": "string" },
    "createdAt": { "type": "string" }
  },
  "required": ["_id", "albumId", "userId", "fileId", "createdAt"],
  "indexes": [
    { "keys": { "albumId": 1, "createdAt": -1 }, "name": "album_time_idx" },
    { "keys": { "userId": 1, "createdAt": -1 }, "name": "user_time_idx" }
  ]
}
