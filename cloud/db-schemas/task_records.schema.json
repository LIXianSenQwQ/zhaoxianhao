/**
 * cloud/db-schemas/task_records.schema.json
 * 任务打卡记录集合（幂等：task:date:uid）
 *
 * 字段：
 *   _id: ObjectId
 *   idemKey: string (幂等键)
 *   userId: string (openid)
 *   taskId: string (任务 ID)
 *   date: Date (打卡日 0 点)
 *   dateStr: string (ISO 日期 'YYYY-MM-DD')
 *   evidence: string (凭证云存储 ID，可选)
 *   status: enum [COMPLETED, REVOKED]
 *   createdAt: Date
 *
 * 权限：仅云函数读写。
 * 索引：idemKey(unique), userId+date, taskId.
 */
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "task_records",
  "description": "任务打卡记录集合",
  "type": "object",
  "properties": {
    "_id": { "type": "string" },
    "idemKey": { "type": "string", "maxLength": 256 },
    "userId": { "type": "string" },
    "taskId": { "type": "string" },
    "date": { "type": "string", "format": "date-time" },
    "dateStr": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "evidence": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["COMPLETED", "REVOKED"],
      "default": "COMPLETED"
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "required": ["_id", "idemKey", "userId", "taskId", "date", "dateStr", "status", "createdAt"],
  "indexes": [
    { "keys": { "idemKey": 1 }, "options": { "unique": true, "name": "idem_unique" } },
    { "keys": { "userId": 1, "date": -1 }, "name": "user_date_desc_idx" },
    { "keys": { "taskId": 1 }, "name": "taskId_idx" }
  ]
}
