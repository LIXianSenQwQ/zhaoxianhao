/**
 * cloud/db-schemas/members.schema.json
 * 成员集合（族谱实体）
 *
 * 字段：
 *   _id: ObjectId
 *   path: string (物化路径 '/001/003/'，子树查询索引)
 *   genealogyName: string (谱名：郝 X 本名)
 *   name: string (本名)
 *   generation: number (世代序数，>=1)
 *   branchId: string (房支标识，可 null)
 *   gender: enum [MALE, FEMALE, UNKNOWN]
 *   lifespan: object { birth: Date, death: Date } (生卒年)
 *   status: enum [ALIVE, DECEASED]
 *   linkedOpenid: string (关联 openid，可选)
 *   memberNo: string (序号 001~999，父节点下唯一)
 *   worshipCount: number (祭祀次数，默认 0)
 *   deeds: array<string> (事迹)
 *   motto: string (家训，选填)
 *   heroNote: string (英模笔记)
 *   privacy: object {
 *     visible: '公开'|'限制'|'私密',
 *     fieldPrivacy?: { name?, gender?, lifespan?, address? }
 *   }
 *   generationChar: string|null (字辈字，框架§3.1)
 *   aliases: array<string> (字号/曾用名，框架§3.1)
 *   birthPlace/deathPlace: string|null (出生/逝世地)
 *   siblingOrder: integer|null (同父排行)
 *   occupation/education: string|null (职业/功名)
 *   tomb: object|null { location, fileId, note } (墓葬)
 *   sourceTags: array<string> (来源标注，框架§3.2 元数据规范)
 *   confidence: integer 1-5|null (置信度，框架§3.3)
 *   version: integer|null (记录版本号)
 *   createdAt: Date, createdBy: string, updatedAt: Date, updatedBy: string
 *
 * 权限：仅云函数读写。
 * 索引：path(前缀), branchId, generation, status, linkedOpenid(path+generation 复合)
 */
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "members",
  "description": "成员集合（族谱实体）",
  "type": "object",
  "properties": {
    "_id": { "type": "string" },
    "path": { "type": "string", "pattern": "^/([0-9]{3}/)*$" },
    "genealogyName": { "type": "string", "maxLength": 64 },
    "name": { "type": "string", "maxLength": 20 },
    "generation": { "type": "integer", "minimum": 1 },
    "branchId": { "type": ["string", "null"] },
    "gender": {
      "type": "string",
      "enum": ["MALE", "FEMALE", "UNKNOWN"]
    },
    "lifespan": {
      "type": "object",
      "properties": {
        "birth": { "type": "string", "format": "date" },
        "death": { "type": "string", "format": "date" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["ALIVE", "DECEASED", "UNKNOWN"],
      "default": "ALIVE"
    },
    "linkedOpenid": { "type": "string", "maxLength": 128 },
    "memberNo": { "type": "string", "pattern": "^[0-9]{3}$" },
    "worshipCount": { "type": "integer", "minimum": 0, "default": 0 },
    "deeds": { "type": "array", "items": { "type": "string" } },
    "motto": { "type": "string", "maxLength": 500 },
    "heroNote": { "type": "string", "maxLength": 2000 },
    "privacy": { "type": "object" },
    "generationChar": { "type": ["string", "null"], "maxLength": 4, "description": "字辈字（框架§3.1 必填语义；由 generations 字辈表按世代匹配或录入时指定）" },
    "aliases": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 32 }, "description": "字号/曾用名（框架§3.1）" },
    "birthPlace": { "type": ["string", "null"], "maxLength": 128, "description": "出生地（框架§3.1，行政区划+文字）" },
    "deathPlace": { "type": ["string", "null"], "maxLength": 128, "description": "逝世地（框架§3.1）" },
    "siblingOrder": { "type": ["integer", "null"], "minimum": 1, "maximum": 99, "description": "同父兄弟排行（框架§3.1）" },
    "occupation": { "type": ["string", "null"], "maxLength": 64, "description": "职业（框架§3.1）" },
    "education": { "type": ["string", "null"], "maxLength": 64, "description": "学历/功名（框架§3.1，历史功名如「道光十八年武进士第一」）" },
    "tomb": {
      "type": ["object", "null"],
      "properties": {
        "location": { "type": ["string", "null"], "maxLength": 256 },
        "fileId": { "type": ["string", "null"], "maxLength": 256, "description": "墓碑影像 fileId（documents/upload_metas）" },
        "note": { "type": ["string", "null"], "maxLength": 500 }
      },
      "description": "墓葬信息（框架§3.1）"
    },
    "sourceTags": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 128 }, "description": "来源标注（框架§3.1 必填语义；引用 research_sources.title 或原始出处文本）" },
    "confidence": { "type": ["integer", "null"], "minimum": 1, "maximum": 5, "description": "置信度 1-5（框架§3.3；5=碑刻原件/DNA 验证，1=传说存疑）" },
    "version": { "type": ["integer", "null"], "minimum": 1, "description": "记录版本号（框架§3.1，乐观锁/修订追溯用）" },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "updatedBy": { "type": "string" }
  },
  "required": ["_id", "path", "genealogyName", "name", "generation", "branchId", "gender", "status", "createdAt", "createdBy"],
  "indexes": [
    { "keys": { "path": 1 }, "options": { "partialFilterExpression": { "path": { "$exists": true } } }, "name": "path_prefix_idx" },
    { "keys": { "branchId": 1, "generation": 1 }, "name": "branch_gen_idx" },
    { "keys": { "status": 1 }, "name": "status_idx" },
    { "keys": { "linkedOpenid": 1 }, "name": "openid_link_idx" }
  ]
}
