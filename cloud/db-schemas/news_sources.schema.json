{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "news_sources",
  "description": "V2.0 F3: 新闻数据源配置（5 家源登记：聚合数据/天行/拓尔思/官方RSS/国际源）",
  "type": "object",
  "properties": {
    "_id": { "type": "string" },
    "name": { "type": "string" },
    "type": { "type": "string", "enum": ["API", "RSS", "ENTERPRISE"] },
    "baseUrl": { "type": "string" },
    "apiKeyRef": { "type": "string" },
    "categories": { "type": "array", "items": { "type": "string" } },
    "quota": { "type": "object" },
    "priority": { "type": "integer" },
    "authorized": { "type": "boolean" },
    "lastFetchAt": { "type": "string", "format": "date-time" },
    "lastFetchStatus": { "type": "string", "enum": ["OK", "FAILED", "QUOTA_EXHAUSTED"] },
    "status": { "type": "string", "enum": ["ACTIVE", "DISABLED"] },
    "isOfficialPolicy": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "required": ["name", "type", "status", "priority"],
  "indexes": [
    { "keys": { "status": 1, "priority": 1 }, "name": "active_priority_idx" }
  ]
}
