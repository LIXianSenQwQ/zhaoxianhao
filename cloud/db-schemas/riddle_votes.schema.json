{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "riddle_votes",
  "description": "V2.0 灯谜会 — 用户答题记录/投票",
  "type": "object",
  "properties": {
    "_id": { "type": "string" },
    "riddleId": { "type": "string" },
    "openid": { "type": "string" },
    "guess": { "type": "string" },
    "correct": { "type": "boolean" },
    "score": { "type": "integer" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "required": ["riddleId", "openid", "createdAt"],
  "indexes": [
    { "keys": { "riddleId": 1, "openid": 1 }, "name": "riddle_user_idx" }
  ]
}